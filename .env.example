# Variables de entorno del FRONTEND (Vite). Ver utc-api/.env.example para las
# del backend — son procesos independientes con su propio .env.
#
# Vite hornea estas variables en tiempo de BUILD, no en tiempo de ejecución:
# cambiar este valor requiere volver a correr el build correspondiente, no
# alcanza con reiniciar el servidor.

# URL base de la API que el frontend compilado va a llamar.
#
# - Modo (a) local (dos procesos, npm run dev): no hace falta definirla — hay
#   un fallback a http://localhost:3001/api en src/app/lib/api/client.ts.
# - Modo (b) un solo servicio (Express sirve el front compilado): usar ruta
#   relativa, mismo origen que sirve el HTML. Ya cubierto por el script
#   "npm run build:single" (no hace falta setearla a mano).
#     VITE_API_BASE_URL=/api
# - Modo (c) dos servicios separados (front y back en hosts distintos): la
#   URL pública completa del backend.
#     VITE_API_BASE_URL=https://tu-backend.onrender.com/api
# - Modo (d) túnel: la URL pública del túnel que expone al backend (si el
#   backend también está tuneleado) o, si se usa el modo (b) con un solo
#   túnel, no hace falta definirla (ruta relativa /api, igual que en (b)).
VITE_API_BASE_URL=http://localhost:3001/api
