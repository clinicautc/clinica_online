# Base de datos (Render Postgres)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Correo
RESEND_API_KEY=
EMAIL_USER=
EMAIL_PASS=

# JWT (Fase B - migracion de auth)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m

# Servidor
PORT=3001

# Modo (b) — un solo servicio: si es 'true', Express sirve el front ya
# compilado (carpeta ../dist, generada con "npm run build:single" desde la
# raíz) y responde index.html para cualquier ruta que no sea /api/*. Dejar en
# 'false' (o sin definir) en modo (a) local y modo (c) dos servicios — en
# esos casos el frontend se sirve por su cuenta (Vite dev server, u otro
# hosting estático) y este backend solo expone la API.
SERVE_STATIC=false

# CORS: orígenes permitidos, separados por coma.
# Si se omite, en dev se permite http://localhost:5173,http://localhost:3000
# En modo (b) (SERVE_STATIC=true) no hace falta agregar ningún origen extra
# aquí: el frontend se sirve desde el mismo origen que la API, así que el
# navegador no hace una petición cross-origin y CORS no entra en juego para
# ese tráfico. Sigue siendo necesario si además accedes a la API desde otro
# origen (ej. Postman/otro front) mientras tanto.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# URL pública del frontend (para botones en correos). En modo (b) es la
# misma URL pública del servicio único (el mismo origen sirve todo); en modo
# (d) túnel, actualizar a la URL vigente del túnel cada vez que cambie.
FRONTEND_URL=http://localhost:5173
